# Broker and webhook settings for src/execution/ (live order placement).
# Nothing in the research pipeline reads these; make test, make demo and the
# factor-mode run all work without this file.
#
# IMPORTANT: unlike the ingest package, this one does NOT load .env by
# itself. It reads plain environment variables, so copying this file to .env
# is not enough on its own. Pick one:
#
#   1. Export them in your shell:
#        set -a; source .env; set +a      # Windows PowerShell: see below
#
#   2. Attach them to the conda environment, so they are set whenever it is
#      active (this is the tidiest option):
#        conda activate msa-agent
#        conda env config vars set ALPACA_API_KEY=... ALPACA_SECRET_KEY=...
#        conda activate msa-agent          # re-activate to pick them up
#
#   3. Put the non-secret ones in configs/execution_config.yaml and leave
#      only the credentials in the environment.
#
# Treat a filled-in copy of this file as a secret. .env is gitignored; keep
# it that way, and never paste real keys into configs/ or into a commit.

# Alpaca credentials. Paper keys start with PK, live keys with AK.
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# true routes to the paper endpoint, false routes to real money.
# The code default is paper, and there is no reason to change this until you
# have watched a full paper session behave the way you expect.
ALPACA_PAPER=true

# Shared secret the webhook requires on every incoming signal. LEAVE THIS
# SET. With it blank the listener accepts unauthenticated trade signals from
# anyone who can reach the port, and only logs a warning.
WEBHOOK_PASSPHRASE=change_me_to_a_long_random_string

# Listener bind address and port. 0.0.0.0 listens on every interface, which
# is what you want behind a reverse proxy or tunnel and NOT what you want on
# an open network; use 127.0.0.1 to keep it on the local machine.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
