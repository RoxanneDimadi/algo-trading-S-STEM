# pylint configuration for algo-trading-S-STEM.
#
# The gate is PEP 8 conformance plus real defects. Everything switched off
# below is switched off for a stated reason, not to make the score look
# better. Run it from either sub-project:
#
#   cd multisignal-alpha/multisignal-alpha && pylint --rcfile=../../.pylintrc src scripts tests
#   cd real-data && pylint --rcfile=../.pylintrc src scripts

[MAIN]
# Optional real-data dependencies. They are commented out of
# requirements.txt on purpose (openassetpricing pulls a large stack; wrds
# needs licensed credentials), so pylint cannot import them in CI.
ignored-modules=openassetpricing,wrds

[FORMAT]
# PEP 8's own limit.
max-line-length=79

[BASIC]
# This is numerical research code whose variables are the symbols of the
# derivations in docs/math: Z is the feature matrix, LAM the coefficient
# path, R the observation-noise series, G a Gram matrix, and so on.
# Renaming them to satisfy snake_case would sever the correspondence
# between the code and the proofs it implements, so short and capitalized
# names are allowed for locals, arguments and attributes.
variable-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
argument-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
attr-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
class-attribute-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
inlinevar-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
good-names=i,j,k,n,m,p,q,r,s,t,w,x,y,z,a,b,c,d,e,f,g,h,v,_

[DESIGN]
# Estimator fits and the pipeline stages carry a lot of state by nature.
# Splitting them to hit pylint's defaults would spread one derivation
# across several functions for no gain in clarity.
max-locals=40
max-args=15
max-positional-arguments=15
max-attributes=20
max-statements=80
max-branches=20
max-returns=10
min-public-methods=0

[MESSAGES CONTROL]
disable=
# PEP 257, not PEP 8. The substantive functions carry docstrings already;
# requiring one on every dataclass, thin HTTP wrapper and main() would add
# filler, so only module docstrings stay mandatory.
    missing-function-docstring,
    missing-class-docstring,
# scikit-learn's estimator convention: fit() defines the fitted attributes
# (ending in _), __init__ only stores hyper-parameters.
    attribute-defined-outside-init,
# Deliberate lazy imports of optional/slow dependencies (matplotlib,
# pandas_datareader, openassetpricing, optuna) inside the one function
# that needs them.
    import-outside-toplevel,
# Fires on the config-plumbing shapes repeated across evaluation modules,
# where the repetition is the readable form.
    duplicate-code,
