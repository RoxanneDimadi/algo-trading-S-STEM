# pylint configuration for algo-trading-S-STEM.
#
# The gate is PEP 8 plus real defects. Each check switched off below has a
# reason next to it. Run it from either sub-project:
#
#   cd multisignal-alpha/multisignal-alpha && pylint --rcfile=../../.pylintrc src scripts tests
#   cd real-data && pylint --rcfile=../.pylintrc src scripts

[MAIN]
# Optional real-data dependencies, commented out of requirements.txt on
# purpose: openassetpricing pulls in a large stack and wrds needs licensed
# credentials. Neither can be imported in CI.
ignored-modules=openassetpricing,wrds

[FORMAT]
# PEP 8's own limit.
max-line-length=79

[BASIC]
# The variables in this code are the symbols used in the derivations under
# docs/math: Z is the feature matrix, LAM the coefficient path, R the
# observation-noise series, G a Gram matrix, and so on. Renaming them to
# fit snake_case would break the link between the code and the proofs, so
# short and capitalised names are allowed for locals, arguments and
# attributes.
variable-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
argument-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
attr-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
class-attribute-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
inlinevar-rgx=[a-zA-Z_][a-zA-Z0-9_]{0,30}$
good-names=i,j,k,n,m,p,q,r,s,t,w,x,y,z,a,b,c,d,e,f,g,h,v,_

[DESIGN]
# Estimator fits and pipeline stages carry a lot of state. Splitting them
# to reach pylint's defaults would spread one derivation over several
# functions without making it clearer.
max-locals=40
max-args=15
max-positional-arguments=15
max-attributes=20
max-statements=80
max-branches=20
max-returns=10
min-public-methods=0

[MESSAGES CONTROL]
disable=
# These are PEP 257 rather than PEP 8. The functions that need docstrings
# already have them; demanding one on every dataclass, thin HTTP wrapper
# and main() only adds filler. Module docstrings stay required.
    missing-function-docstring,
    missing-class-docstring,
# scikit-learn's estimator convention: fit() defines the fitted attributes
# (ending in _), __init__ only stores hyper-parameters.
    attribute-defined-outside-init,
# Lazy imports of optional or slow dependencies (matplotlib,
# pandas_datareader, openassetpricing, optuna), done inside the one
# function that needs them.
    import-outside-toplevel,
# Fires on the config plumbing repeated across the evaluation modules,
# where repeating it is the readable option.
    duplicate-code,
