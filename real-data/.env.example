# Paths (relative to this repo root)
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed

# Where to copy files for the research agent
AGENT_ROOT=../multisignal-alpha/multisignal-alpha
AGENT_RAW_DIR=../multisignal-alpha/multisignal-alpha/data/raw

# OSAP (Chen–Zimmermann). Leave blank for latest release.
# Examples: 202410, 202408 — see openassetpricing.list_release()
OSAP_RELEASE=

# Signals to download (comma-separated). STreversal is CRSP-only; we build it from returns.
OSAP_SIGNALS=Mom12m,Illiquidity,IdioVol3F,BM,GP

# Kenneth French library start date
FRENCH_START=1963-07

# Optional WRDS (for CRSP monthly returns). Leave blank to skip / use returns.csv.
WRDS_USERNAME=
WRDS_PASSWORD=

# If you already have a returns file, point at it (permno,yyyymm,ret[,dlret])
RETURNS_CSV=
