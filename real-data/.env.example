# Copy this file to .env in the same directory, then edit as needed:
#
#   cp .env.example .env        # Windows: copy .env.example .env
#
# The ingest package loads .env automatically (python-dotenv), so anything
# set here takes effect the next time you run a script. Every value below is
# optional: with the file left exactly as shipped, the no-WRDS factor path
# runs as it is. Nothing here is a secret unless you add WRDS credentials,
# and .env is gitignored either way.

# Where ingest reads and writes, relative to the real-data directory.
DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed

# Where the built files get copied for the research agent.
AGENT_ROOT=../multisignal-alpha/multisignal-alpha
AGENT_RAW_DIR=../multisignal-alpha/multisignal-alpha/data/raw

# OSAP release (Chen-Zimmermann). Leave blank for the latest.
# For a pinned release use e.g. 202410 or 202408; openassetpricing.list_release()
# prints what is available.
OSAP_RELEASE=

# Firm-level signals to download, comma separated. STreversal is CRSP-only,
# so it is built from returns instead of downloaded.
# Note this does NOT control the long-short portfolios used by factor mode;
# those follow osap.portfolio_signals in configs/data_config.yaml, which
# ships as "all".
OSAP_SIGNALS=Mom12m,Illiquidity,IdioVol3F,BM,GP

# Start date for the Kenneth French factor library.
FRENCH_START=1963-07

# Optional WRDS credentials, for CRSP monthly returns. Leave blank to skip
# WRDS entirely; the factor path does not need it. Requires pip install wrds.
WRDS_USERNAME=
WRDS_PASSWORD=

# If you already hold a returns file, point at it instead of using WRDS.
# Columns: permno,yyyymm,ret and optionally dlret. Setting this unlocks
# data.mode: osap in the agent.
RETURNS_CSV=
